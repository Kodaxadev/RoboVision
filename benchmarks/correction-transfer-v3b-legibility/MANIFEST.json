  "reproducibility_claim": "normalized-authoring equivalent, not byte-identical. Blender issues fresh RoboVision identities on every create, so two correct restores differ in every object UUID, world incarnation, revision and journal position. The signature hashes object names, parent names, world transforms, local and world extents, mesh topology counts, materials and modifiers, and excludes all run-specific identity. Every restore is checked against it, and against the frozen Q0 vector, before a participant run may begin.",
  "hidden_commitments": {
    "generator": "sha256:e8b1b5203418d78bba6ab8b31dc3f4fb41741e37b6cf6e546815742f45db7c9f",
    "sealed_seed_and_target": "sha256:72aeb675f66ab44b7c7167699f76c523d3b8065726c8d6f1dd09113997ff967e",
    "private_restore_specification": "sha256:37a504fa2121084cea8e6dc77a82bbcafddd93e5127af97cdd0b294322a4eeb4",
    "meaning": "published before the first run; the files can be revealed afterwards and re-hashed to show nothing was altered between participants. A hash commitment is evidence of immutability, not disclosure."
  },
  "record_per_run": [
    "model identity and version",
    "accepted / rejected / indeterminate attempts",
    "attempts marked invalid or incomplete, with the reason",
    "rollback proofs (begin and final fingerprints per attempt)",
    "correction execution tool calls",
    "participant observation tool calls",
    "total participant-facing calls",
    "token usage where observable, otherwise self-reported or null",
    "elapsed seconds",
    "DAT Q0 and final vectors",
    "hard invariants",
    "shaded visual captures",
    "manual interventions",
    "structured stop reason and note"
  ],
  "comparison_rules": [
    "identical budget, tools, DAT policy and references for every model",
    "epsilon and tolerances are never tuned per model",
    "if a real DAT metric defect is found, stop the comparison, fix it with an independent regression test, version the benchmark and restart affected runs \u2014 never patch mid-comparison",
    "no scalar overall quality score is produced",
    "a participant that has read hidden benchmark material, or that built RoboVision, is recorded as non-independent"
  ],
