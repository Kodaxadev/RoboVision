{
  "benchmark": "rvbench:correction-transfer/v2",
  "status": {
    "label": "blind correction-transfer benchmark",
    "note": "the challenge-generation material is held outside the public RoboVision repository; only its digests are published here"
  },
  "task": "correction transfer: improve a frozen flawed asset using RoboVision evidence. Creation ability is a separate experiment and is not measured here.",
  "budget": {
    "max_attempts": 8,
    "attempt_counts": "accepted, rejected and indeterminate attempts all count",
    "observation_budgeted": false,
    "observation_policy": "observation is unbudgeted; participant observation calls are counted and reported separately from correction execution calls, never merged into one efficiency figure",
    "epsilon_policy": "the participant declares an epsilon per target; the harness audits it against the metric's own resolution and records any improvement below that resolution as unproven",
    "tolerance_policy": "protected metrics use the tolerances the participant declares; the harness does not relax them on rejection"
  },
  "disclosed_to_participant": [
    "the written asset brief, including the declared overall envelope and the kinds of fault that are possible",
    "the two reference silhouettes and the frame each was captured in",
    "the restored A0, live and freely inspectable through the facade",
    "every read-only RoboVision operation, and the parameter schema of every operation including mutating ones",
    "system.health",
    "authoritative observations and the DAT discrepancy packet",
    "shaded viewport captures"
  ],
  "withheld_from_participant": [
    "the generator that produced the target asset, the references and the faults",
    "the seed, the sealed target specification and the applied faults",
    "the private restore recipe that reconstructs A0",
    "the asset's internal proportions, beyond the declared overall envelope",
    "the RoboVision repository source",
    "any previous participant's trajectory, correction JSON or reasoning"
  ],
  "known_limits": [
    "The references constrain the front and side outlines only. Geometry hidden behind the silhouette in both views is not constrained by them.",
    "Coverage measures inspectability, not quality. A low observed fraction is not by itself a defect to correct.",
    "Pattern orientation is measured as agreement between each member's own principal axis and its siblings'. The brackets are authored co-oriented and the brief says so, because a radial array whose members turned with the array would report the design as a deviation.",
    "reference.absolute_proportion is unmeasured unless a frame is declared; these references carry their capture frame, so the comparison is absolute."
  ],
  "required_invariants": [
    "geometry.manifold",
    "geometry.no_degenerate_faces",
    "geometry.normals_consistent",
    "geometry.no_unintended_open_boundaries",
    "geometry.no_self_intersection"
  ],
