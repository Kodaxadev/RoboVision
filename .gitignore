# Benchmark answer keys must never reach the public repository, even by
# accident. The real material lives outside it at $RVBENCH_PRIVATE; this is a
# second lock on the door rather than the door.
benchmarks/**/SEALED-*
benchmarks/**/restore.json
benchmarks/**/expected.json

# Stray participant correction JSON must not land in the repo. Previous
# participants trajectories are listed as withheld in the v2 manifest, and a
# claim that fails because someone ran `git add -A` in the wrong directory is
# still a false claim.
/attempt-*.json
